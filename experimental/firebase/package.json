{
  "name": "raytech-firebase-emulator",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prepare": "node prepare-emulator.cjs",
    "install-functions": "npm --prefix .emulator-functions install --no-audit --no-fund",
    "test:emulator": "firebase emulators:exec --project demo-raytech-cg --only auth,firestore,functions \"node --test emulator.test.mjs\"",
    "serve": "vite --host 127.0.0.1",
    "test:queue": "node --test queue.test.mjs staging-guard.test.mjs",
    "test:browser": "firebase emulators:exec --project demo-raytech-cg --only auth,firestore,functions \"playwright test\"",
    "build:staging": "vite build --config vite.staging.config.mjs && node verify-staging-build.mjs",
    "package:hml": "node hml-artifact.mjs package",
    "test:hml": "node --test staging-hml-*.test.mjs",
    "report:hml": "node hml-artifact.mjs report"
  },
  "dependencies": {
    "firebase": "12.6.0"
  },
  "devDependencies": {
    "firebase-tools": "14.26.0",
    "vite": "7.2.2",
    "fake-indexeddb": "6.2.4",
    "@playwright/test": "1.56.1"
  }
}
